{
    "dataset_path": "data_en",
    "dataset_format": "csv",
    "embedding_save_path": "embeddings/",
    "output_path": "outputs/",
    "language": "en",
    "bert_model": "bert-base-uncased",
    "batch_size": 32,
    "device": "cuda",
    "cg3_use": true,
    "cg3_epochs": 300,
    "cg3_lr": 0.005,
    "cg3_k": 5,
    "cg3_threshold": 0.9,
    "cg3_sigma": 0.5,
    "cg3_warmup": 10,
    "llgc_use": true,
    "llgc_alpha": 0.99,
    "manifold_use": true,
    "manifold_k": 5,
    "manifold_epochs": 200,
    "manifold_sigma": 0.5,
    "manifold_components": 128,
    "manifold_lr": 0.005,
    "manifold_landmarks": 1000,
    "mixtext_use": true,
    "mixtext_epochs": 100,
    "mixtext_lr": 0.001,
    "mixtext_alpha": 0.4
}