{
    "dataset_path": "data_tmp",
    "dataset_format": "txt",
    "embedding_save_path": "embeddings/",
    "output_path": "outputs/",
    "language": "zh",
    "bert_model": "hfl/chinese-roberta-wwm-ext",
    "batch_size": 32,
    "device": "cuda",
    "cg3_use": true,
    "cg3_epochs": 200,
    "cg3_lr": 0.001,
    "cg3_k": 15,
    "cg3_threshold": 0.7,
    "cg3_sigma": 0.5,
    "cg3_warmup": 10,
    "llgc_use": false,
    "llgc_alpha": 0.99,
    "manifold_use": true,
    "manifold_epochs": 400,
    "manifold_k": 10,
    "manifold_sigma": 0.5,
    "manifold_components": 64,
    "manifold_lr": 0.001,
    "manifold_landmarks": 1000,
    "mixtext_use": true,
    "mixtext_epochs": 100,
    "mixtext_lr": 0.001,
    "mixtext_alpha": 0.4
}